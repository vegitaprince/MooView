<Window x:Class="MooView.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MooView" Icon="Assets/MooView.ico" Style="{StaticResource {x:Type Window}}" Title="MooView" Width="1440" Height="940" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" PreviewKeyDown="OnKey" PreviewMouseDown="OnMouseButton" MouseMove="OnMouseMove" Drop="OnDrop" DragOver="OnDragOver">
 <Grid x:Name="Root" Margin="18" Focusable="True">
  <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="250"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
  <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragCompleted="SidebarResizeCompleted" ToolTip="{local:Loc ResizeSidebar}" Focusable="True" Background="Transparent"><GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><Border Width="2" Height="46" CornerRadius="1" Background="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></ControlTemplate></GridSplitter.Template></GridSplitter>
  <Border x:Name="Rail" Grid.RowSpan="2" Style="{StaticResource Card}" Margin="0,0,14,0" Background="{DynamicResource Rail}"><DockPanel Margin="7,12"><DockPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="6"/></Style></DockPanel.Resources><StackPanel DockPanel.Dock="Top"><Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Accent}" Margin="0,0,0,20"><local:Glyph Kind="image" Width="23" Height="23"/></Border>
   <Button Click="OpenFiles" ToolTip="{local:Loc Open}" Padding="6"><local:Glyph Kind="image"/></Button><Button Click="OpenFolder" ToolTip="{local:Loc Folder}" Padding="6"><local:Glyph Kind="folder"/></Button><Button Click="ToggleNav" ToolTip="{local:Loc Sidebar}" Padding="6"><local:Glyph Kind="sidebar"/></Button><Button Click="ToggleExif" ToolTip="{local:Loc Info}" Padding="6"><local:Glyph Kind="info"/></Button>
  </StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Button x:Name="ThemeButton" Click="ToggleTheme" PreviewMouseRightButtonUp="UseSystemTheme" ToolTip="{local:Loc Theme}" Padding="6"><local:Glyph Kind="theme"/></Button><Button x:Name="LanguageButton" Click="ToggleLanguage" ToolTip="{local:Loc Language}" Padding="6"><local:Glyph Kind="language"/></Button><Button Click="SetDefaultApp" ToolTip="{local:Loc DefaultApp}" Padding="6"><local:Glyph Kind="settings"/></Button><Button x:Name="UpdateButton" Click="ShowUpdates" ToolTip="{local:Loc Updates}" Padding="6"><local:Glyph Kind="update"/></Button><Button Click="ShowHelp" ToolTip="{local:Loc Help}" Padding="6"><local:Glyph Kind="help"/></Button></StackPanel></DockPanel></Border>
  <Border x:Name="Sidebar" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="MooView" FontSize="24" FontWeight="SemiBold" Margin="5,10,0,18"/><TextBlock x:Name="FolderLabel" Text="{local:Loc Library}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" Margin="5,0,0,10"/><TextBox x:Name="Search" ToolTip="{local:Loc Search}" TextChanged="SearchChanged"/><DockPanel Margin="0,8"><local:Glyph Kind="list" Width="17" Height="17" VerticalAlignment="Center"/><Slider x:Name="BrowserSize" Minimum="0" Maximum="144" Value="0" Width="105" VerticalAlignment="Center" Margin="8,0" ToolTip="{local:Loc BrowserSize}" ValueChanged="BrowserSizeChanged"/><local:Glyph Kind="grid" Width="17" Height="17" VerticalAlignment="Center"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,3"><Button Click="SelectAllFiles" ToolTip="{local:Loc SelectAll}"><local:Glyph Kind="selectall"/></Button><Button Click="ClearSelection" ToolTip="{local:Loc ClearSelection}"><local:Glyph Kind="deselect"/></Button></StackPanel></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="SelectionLabel" Margin="4,12" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal"><Button Click="BatchConvert" ToolTip="{local:Loc Convert}"><local:Glyph Kind="convert"/></Button><Button Click="BatchRename" ToolTip="{local:Loc Rename}"><local:Glyph Kind="rename"/></Button></StackPanel></StackPanel><ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Multiple" SelectionChanged="FileChosen" ScrollViewer.CanContentScroll="False"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></DockPanel></Border>
  <Border x:Name="Stage" Grid.Column="3" Grid.Row="0" Style="{StaticResource Card}" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="ToolbarRow" Background="Transparent" MouseLeftButtonDown="TitleDrag"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><WrapPanel x:Name="ViewToolbar" Margin="10,8,0,8"><WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="36"/><Setter Property="Padding" Value="6"/></Style></WrapPanel.Resources><Button Click="Previous" ToolTip="{local:Loc Previous}"><local:Glyph Kind="previous" Width="20" Height="20"/></Button><Button Click="Next" ToolTip="{local:Loc Next}"><local:Glyph Kind="next" Width="20" Height="20"/></Button>
    <ComboBox x:Name="PageCount" SelectedIndex="0" SelectionChanged="ViewChanged" ToolTip="{local:Loc Pages}" MinWidth="48"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox>
    <ComboBox x:Name="LayoutMode" SelectedIndex="1" SelectionChanged="ViewChanged" ToolTip="{local:Loc Layout}" MinWidth="64"><ComboBoxItem ToolTip="{local:Loc Horizontal}"><local:Glyph Kind="horizontal" Width="20" Height="18"/></ComboBoxItem><ComboBoxItem ToolTip="{local:Loc Grid}"><local:Glyph Kind="grid" Width="20" Height="18"/></ComboBoxItem><ComboBoxItem ToolTip="{local:Loc Vertical}"><local:Glyph Kind="vertical" Width="20" Height="18"/></ComboBoxItem></ComboBox>
    <ComboBox x:Name="FitMode" SelectedIndex="0" SelectionChanged="ZoomChanged" ToolTip="{local:Loc Fit}"><ComboBoxItem Content="{local:Loc FitWindow}"/><ComboBoxItem Content="{local:Loc FillWindow}"/><ComboBoxItem Content="{local:Loc FitWidth}"/><ComboBoxItem Content="{local:Loc ActualSize}"/><ComboBoxItem Content="{local:Loc CustomSize}"/></ComboBox><TextBox x:Name="ZoomInput" Text="100" Width="52" ToolTip="{local:Loc Zoom}" KeyDown="ZoomEntered"/><TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <Button Click="ZoomOut" ToolTip="{local:Loc ZoomOut}"><local:Glyph Kind="minus" Width="20" Height="20"/></Button><Button Click="ZoomIn" ToolTip="{local:Loc ZoomIn}"><local:Glyph Kind="plus" Width="20" Height="20"/></Button><Button x:Name="GifButton" Visibility="Collapsed" Click="ToggleGif" ToolTip="{local:Loc Gif}"><local:Glyph Kind="pause" Width="20" Height="20"/></Button><Button x:Name="AlphaButton" Click="ToggleAlpha" ToolTip="{local:Loc Alpha}"><local:Glyph Kind="alpha" Width="20" Height="20"/></Button><Button Click="EditImage" ToolTip="{local:Loc Edit}"><local:Glyph Kind="edit" Width="20" Height="20"/></Button><Button x:Name="FullscreenButton" Click="ToggleFull" ToolTip="{local:Loc Fullscreen}"><local:Glyph Kind="fullscreen" Width="20" Height="20"/></Button>
   </WrapPanel><Grid x:Name="WindowHeader" Grid.Column="1" Margin="8,8,10,8" VerticalAlignment="Top"><StackPanel x:Name="WindowButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="MinimizeButton" Click="MinimizeWindow" ToolTip="{local:Loc Minimize}" Width="36" Height="36" Padding="6" Margin="3"><local:Glyph Kind="minus" Width="20" Height="20"/></Button>
    <Button x:Name="MaximizeButton" Click="MaximizeWindow" ToolTip="{local:Loc Maximize}" Width="36" Height="36" Padding="6" Margin="3"><local:Glyph Kind="maximize" Width="20" Height="20"/></Button>
    <Button x:Name="CloseWindowButton" Click="CloseWindow" ToolTip="{local:Loc Close}" Width="36" Height="36" Padding="6" Margin="3"><local:Glyph Kind="close" Width="20" Height="20"/></Button>
   </StackPanel></Grid></Grid><Grid Grid.Row="1" x:Name="ImageArea"><Grid x:Name="Pages"/><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"><local:Glyph Kind="image" Width="72" Height="72" HorizontalAlignment="Center"/><TextBlock Text="MooView" FontSize="30" HorizontalAlignment="Center" Margin="0,20,0,10"/><TextBlock Text="{local:Loc Drop}" Foreground="{DynamicResource Muted}"/><Button Click="OpenFiles" ToolTip="{local:Loc Open}" Margin="50,20"><local:Glyph Kind="folder"/></Button></StackPanel>
    <Border x:Name="ExifPanel" Style="{StaticResource Card}" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="14" Visibility="Collapsed" Panel.ZIndex="3"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="EXIF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Click="CopyExif" ToolTip="{local:Loc Copy}"><local:Glyph Kind="copy" Width="16" Height="16"/></Button><Button Click="ToggleExif" ToolTip="{local:Loc Close}"><local:Glyph Kind="close" Width="16" Height="16"/></Button></StackPanel><ScrollViewer MaxHeight="450"><TextBox x:Name="ExifText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></ScrollViewer></DockPanel></Border>
   </Grid></Grid></Border>
  <Border x:Name="BottomBar" Grid.Column="3" Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,6" Panel.ZIndex="20"><Grid VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="FileNameLabel" Text="MooView" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,3,0,0"><TextBlock x:Name="CounterLabel" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,10,0"/><TextBlock x:Name="StatusLabel" Text="{local:Loc Shortcuts}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PlayButton" Click="TogglePlay" ToolTip="{local:Loc Slideshow}" Height="36" Width="36" Padding="6"><local:Glyph Kind="play" Width="20" Height="20"/></Button><ComboBox x:Name="FpsInput" IsEditable="True" Text="1" Width="65" ToolTip="{local:Loc Fps}"><ComboBoxItem Content="0.5"/><ComboBoxItem Content="1"/><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="24"/><ComboBoxItem Content="30"/></ComboBox><TextBlock Text="fps" VerticalAlignment="Center" Margin="3,0,10,0"/><ToggleButton x:Name="LoopButton" Style="{StaticResource IconToggle}" IsChecked="True" Height="36" Width="36" Padding="6" ToolTip="{local:Loc Loop}" VerticalAlignment="Center"><local:Glyph Kind="loop" Width="20" Height="20"/></ToggleButton></StackPanel>
   <local:SeekSlider x:Name="ImageSlider" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource {x:Type Slider}}" Minimum="0" Maximum="0" Value="0" IsEnabled="False" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" Height="20" Margin="0,2,0,0" ToolTip="{local:Loc Seek}" ValueChanged="ImageSliderChanged"/>
  </Grid></Border>
 </Grid>
</Window>
